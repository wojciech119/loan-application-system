@model LoanApplicationSystem.Models.CmsPage?

@{
    ViewData["Title"] = "Start";
}

<div class="home-wrapper">
    <div class="home-title">
        <h1>Obsługa wniosków kredytowych</h1>
    </div>

    @if (User.Identity?.IsAuthenticated == true && Model != null)
    {
        <div class="home-announcement-panel mb-4">
            <h2>@Model.Title</h2>
            <p>@Model.Content</p>
        </div>
    }

    <div class="home-action-list">
        <a asp-controller="LoanApplications"
           asp-action="Create"
           class="home-action-panel">
            Nowy wniosek
        </a>

        <a asp-controller="LoanApplications"
           asp-action="Index"
           class="home-action-panel">
            Wnioski
        </a>

        @if (User.IsInRole("Administrator"))
        {
            <a asp-controller="Admin"
               asp-action="Index"
               class="home-action-panel supervisor-panel">
                Panel przełożonego
            </a>

            <a asp-controller="Cms"
               asp-action="Index"
               class="home-action-panel announcement-panel">
                Ogłoszenia
            </a>
        }
    </div>
</div>